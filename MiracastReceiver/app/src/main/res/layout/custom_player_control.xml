<?xml version="1.0" encoding="utf-8"?>
<!--
  播放/暂停与时间显示在进度条两端，控制栏保持紧凑、不遮挡画面。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/bg_player_control_scrim"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingTop="12dp"
    android:paddingRight="24dp"
    android:paddingBottom="12dp">

    <!-- 进度条和时间 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Media3 识别此 ID，并自动根据播放状态切换图标和点击行为。 -->
        <ImageButton
            android:id="@+id/exo_play_pause"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="false"
            android:contentDescription="当前播放状态"
            android:focusable="false"
            android:scaleType="center"
            android:tint="@color/text_primary" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_preview_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1">
            <androidx.media3.ui.DefaultTimeBar
                android:id="@+id/exo_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:played_color="?attr/colorAccent"
                app:buffered_color="@color/text_secondary"
                app:unplayed_color="#40FFFFFF"
                app:scrubber_color="?attr/colorAccent"
                app:scrubber_enabled_size="14dp"
                app:scrubber_disabled_size="0dp" />
            <androidx.media3.ui.DefaultTimeBar
                android:id="@+id/preview_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:played_color="?attr/colorAccent"
                app:buffered_color="@color/text_secondary"
                app:unplayed_color="#40FFFFFF"
                app:scrubber_color="?attr/colorAccent"
                app:scrubber_enabled_size="14dp"
                app:scrubber_disabled_size="0dp" />
        </FrameLayout>

        <TextView
            android:id="@+id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
